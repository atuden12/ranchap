# Copy to .env (local) or set as Fly.io secrets (production).
# Local-only development can leave APP_USERNAME and APP_PASSWORD_HASH unset —
# auth defaults to OPEN when both are missing.

# Single shared login. Both must be set together.
APP_USERNAME=admin
# Generate the hash with:  npm run hash-password -- "your password here"
APP_PASSWORD_HASH=$2a$12$REPLACE_WITH_REAL_HASH

# Random 32+ char string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-real-random-bytes

# Optional: override the SQLite DB path. Default: ../RanchApp-Data/ranch.db (local)
# or /data/ranch.db (container). Fly.io's fly.toml sets this to /data/ranch.db.
# RANCHAPP_DB=

# Optional: override port. Default 4317 local, 8080 container.
# PORT=4317
