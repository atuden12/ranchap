{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install --workspaces --include-workspace-root && npm run build:shared && npm --workspace @ranchapp/web run build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!api|assets|favicon.ico|manifest.webmanifest|icon.*\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
