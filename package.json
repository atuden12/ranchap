{
  "name": "ranchapp",
  "version": "0.1.0",
  "private": true,
  "description": "Ranch management app — replaces Stock_Flow_MASTER workbook",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "npm-run-all build:shared --parallel dev:api dev:web",
    "dev:api": "npm --workspace @ranchapp/api run dev",
    "dev:web": "npm --workspace @ranchapp/web run dev",
    "build": "npm-run-all build:shared build:api build:web",
    "build:shared": "npm --workspace @ranchapp/shared run build",
    "build:api": "npm --workspace @ranchapp/api run build",
    "build:web": "npm --workspace @ranchapp/web run build",
    "test": "npm --workspace @ranchapp/shared run test",
    "migrate": "npm --workspace @ranchapp/api run migrate",
    "import": "npm --workspace @ranchapp/api run import --",
    "inspect": "npm --workspace @ranchapp/api run inspect --",
    "hash-password": "npm --workspace @ranchapp/api run hash-password --",
    "start": "node apps/api/dist/server.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  }
}
